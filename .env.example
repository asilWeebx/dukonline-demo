# Shared across every dukonline storefront. The tenant is selected by the
# storefront key, not by this URL, so it only changes for a local backend.
DUKONLINE_API_URL=https://api.dukonline.uz/api

# ERP SuperAdmin panel -> organization -> Online Store.
# Server-side only: it is never exposed to the browser bundle.
DUKONLINE_STOREFRONT_KEY=

# Optional. Set to 1 in .env.local to serve a placeholder catalog when the API
# is unreachable or refuses the key, so the UI can be reviewed without a live
# tenant. A red ribbon marks every page while it is active.
# Ignored on the Vercel production deployment. Never set it there.
# STOREFRONT_DEMO=1
